# Cortex .env is for secrets and runtime overrides.
# Main structured settings should live in ./cortex.json

# Minimal local/private setup:
# CORTEX_AUTH_TOKEN=change-me-local-token
# OPENAI_API_KEY=sk-your-key-here

# Runtime overrides (optional)
CORTEX_PORT=21100
CORTEX_HOST=127.0.0.1
CORTEX_DB_PATH=cortex/brain.db

# Auth token (recommended outside localhost)
# When set, the dashboard requires login and all API calls need Bearer auth.
# CORTEX_AUTH_TOKEN=change-me-local-token

# Provider secrets (optional if you paste keys in Dashboard)
# OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# GOOGLE_API_KEY=your-google-key
# GEMINI_API_KEY=your-gemini-key
# DEEPSEEK_API_KEY=your-deepseek-key
# OPENROUTER_API_KEY=your-openrouter-key
# VOYAGE_API_KEY=your-voyage-key
# COHERE_API_KEY=your-cohere-key
# JINA_API_KEY=your-jina-key
# SILICONFLOW_API_KEY=your-siliconflow-key

# Optional local model endpoint
# OLLAMA_BASE_URL=http://localhost:11434

# Optional graph backend
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-password

# Runtime environment
# TZ=UTC
LOG_LEVEL=info
